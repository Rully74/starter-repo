# Copia este archivo como .env.local y completa los valores de TU proyecto de Supabase.
#   cp .env.example .env.local
#
# Si lo dejas vacío, la aplicación funciona igual: Supabase es opcional.
#
# IMPORTANTE: toda variable que empiece por VITE_ termina dentro del código
# que se ejecuta en el navegador. Aquí SOLO va la Publishable Key.
# NUNCA coloques la Secret Key, service_role key, contraseñas ni secretos de APIs.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=